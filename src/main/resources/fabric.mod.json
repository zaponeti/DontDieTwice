{
	"schemaVersion": 1,
	"id": "diehardpractice",
	"version": "${version}",
	"name": "Don't Die Twice - Practice mode",
	"description": "Practice Bastions, Fortresses, the Ender Dragon, and End Cities instantly - pick a target and a gear tier, get teleported in with a raid timer running.",
	"authors": [
		"Zaponeti"
	],
	"contact": {},
	"license": "MIT",
	"icon": "assets/diehardpractice/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.diehardpractice.DieHardPractice"
		],
		"client": [
			"com.diehardpractice.client.DieHardPracticeClient"
		]
	},
	"mixins": [
		"diehardpractice.mixins.json",
		{
			"config": "diehardpractice.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": "*"
	}
}
